// A three-voice canon: the same phrase, entered one bar apart.
// Worth opening the piano roll in the HTML report for this one -- the
// staircase of entries is the picture of parallel composition.

tempo 108 ;
key G major ;
duration 8 ;
velocity 84 ;

instrument piano   = "acoustic grand piano" ;
instrument strings = "string ensemble 1" ;
instrument reed    = "clarinet" ;

phrase theme = [ ^1 ^3 ^5 ^3 ^4 ^2 ^1/4 ] ;

voice first  on piano   = repeat 3 of theme ;
voice second on strings = [ r/1 ] repeat 3 of theme ;
voice third  on reed    = [ r/1 r/1 ] repeat 3 of theme ;

play first | second | third ;
